rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Band members availability synchronization
    match /member_availability/{memberId} {
      allow read: if true;
      allow write: if memberId is string 
        && memberId.size() > 0 
        && memberId.size() <= 64
        && request.resource.data.memberId == memberId
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() > 0
        && request.resource.data.memberName.size() <= 64
        && request.resource.data.dates is map
        && request.resource.data.updatedAt is string;
    }

    // Band members custom colors synchronization
    match /member_colors/{colorDoc} {
      allow read: if true;
      allow write: if colorDoc is string
        && colorDoc.size() > 0
        && colorDoc.size() <= 64
        && request.resource.data.colors is map
        && request.resource.data.updatedAt is string;
    }
  }
}
